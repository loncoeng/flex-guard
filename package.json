{
  "name": "flex-guard",
  "version": "0.1.0",
  "description": "Catch what LINE rejects, and what it renders wrong without telling you",
  "license": "MIT",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"test/*.test.ts\"",
    "check": "tsc --noEmit",
    "build": "tsc",
    "spec:generate": "node scripts/generate-spec.ts"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.4.0",
    "js-yaml": "^5.4.1",
    "typescript": "^5.6.0"
  }
}
